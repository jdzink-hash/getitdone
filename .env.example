# Random string used to sign sessions — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Email (leave SMTP_HOST blank in development: codes and emails are printed to the terminal instead)
# Works with any SMTP provider, e.g. Gmail (smtp.gmail.com, 587, with an App Password), Resend, Postmark, SendGrid.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender shown to users, e.g. Get It Done <hello@yourdomain.com>
EMAIL_FROM=

# Where the SQLite database lives (defaults to ./getitdone.db)
DATABASE_PATH=

# Set to 0 on any extra web processes so only one runs the morning-email scheduler
RUN_SCHEDULER=1

# Public address of the app, used in calendar feed links (optional; defaults to the address in the browser)
PUBLIC_URL=

# Set to 1 when served over HTTPS
SECURE_COOKIES=0
